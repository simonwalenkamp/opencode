{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["github-copilot"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*.zshrc": "deny",
      "trifrost": "deny",
      "trifrost/*": "deny",
      "*/trifrost": "deny",
      "*/trifrost/*": "deny",

      "*.ssh": "deny",
      "*.ssh/*": "deny",
      "*.aws": "deny",
      "*.aws/*": "deny",
      "*.gnupg": "deny",
      "*.gnupg/*": "deny",
      "*.kube/config": "deny",
      "*.docker/config.json": "deny",
      "*.config/gh/hosts.yml": "deny",
      "*.local/share/opencode/auth.json": "deny",
      "*.netrc": "deny"
    },

    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*.zshrc": "deny",
      "trifrost": "deny",
      "trifrost/*": "deny",
      "*/trifrost": "deny",
      "*/trifrost/*": "deny",

      "*.ssh": "deny",
      "*.ssh/*": "deny",
      "*.aws": "deny",
      "*.aws/*": "deny",
      "*.gnupg": "deny",
      "*.gnupg/*": "deny",
      "*.kube/config": "deny",
      "*.docker/config.json": "deny",
      "*.config/gh/hosts.yml": "deny",
      "*.local/share/opencode/auth.json": "deny",
      "*.netrc": "deny"
    },

    "external_directory": {
      "*": "ask",
      "trifrost": "deny",
      "trifrost/*": "deny",
      "*/trifrost": "deny",
      "*/trifrost/*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gh/*": "deny"
    },

    "bash": {
      "*": "allow",

      "sudo": "deny",
      "sudo *": "deny",
      "*/sudo": "deny",
      "*/sudo *": "deny",
      "command sudo": "deny",
      "command sudo *": "deny",
      "rm": "deny",
      "rm *": "deny",
      "*/rm": "deny",
      "*/rm *": "deny",
      "command rm": "deny",
      "command rm *": "deny",
      "git reset --hard*": "deny",
      "git * reset --hard*": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git * clean": "deny",
      "git * clean *": "deny",
      "git restore": "deny",
      "git restore *": "deny",
      "git * restore": "deny",
      "git * restore *": "deny",
      "git checkout --": "deny",
      "git checkout -- *": "deny",
      "git * checkout --": "deny",
      "git * checkout -- *": "deny",
      "git stash drop": "deny",
      "git stash drop *": "deny",
      "git * stash drop": "deny",
      "git * stash drop *": "deny",
      "git reflog expire": "deny",
      "git reflog expire *": "deny",
      "git * reflog expire": "deny",
      "git * reflog expire *": "deny",
      "docker system prune*": "deny",
      "docker * system prune*": "deny",
      "gh repo delete*": "deny",
      "gh * repo delete*": "deny",
      "terraform destroy*": "deny",
      "terraform * destroy*": "deny",

      "kontext": "deny",
      "kontext *": "deny",
      "*/kontext": "deny",
      "*/kontext *": "deny",
      "command kontext": "deny",
      "command kontext *": "deny",
      "ansible-vault": "deny",
      "ansible-vault *": "deny",
      "*/ansible-vault": "deny",
      "*/ansible-vault *": "deny",
      "command ansible-vault": "deny",
      "command ansible-vault *": "deny",
      "eval-env": "deny",
      "eval-env *": "deny",
      "*/eval-env": "deny",
      "*/eval-env *": "deny",
      "command eval-env": "deny",
      "command eval-env *": "deny",

      "git push --force": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease": "deny",
      "git push --force-with-lease *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push * --force*": "deny",
      "git push * --force-with-lease*": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git * push --force*": "deny",
      "git * push * --force*": "deny",
      "git * push -f": "deny",
      "git * push -f *": "deny",
      "git * push * -f": "deny",
      "git * push * -f *": "deny"
    }
  }
}
