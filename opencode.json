{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "github-copilot"
  ],
  "agent": {
    "explore": {
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "low"
    }
  },
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "*.zshrc": "deny",
      "trifrost": "deny",
      "trifrost/*": "deny",
      "*/trifrost": "deny",
      "*/trifrost/*": "deny",
      "*.ssh": "deny",
      "*.ssh/*": "deny",
      "*.aws": "deny",
      "*.aws/*": "deny",
      "*.gnupg": "deny",
      "*.gnupg/*": "deny",
      "*.kube": "deny",
      "*.kube/*": "deny",
      "*.docker": "deny",
      "*.docker/*": "deny",
      "*.config/gh": "deny",
      "*.config/gh/*": "deny",
      "*.local/share/opencode/auth.json": "deny",
      "*.netrc": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny"
    },
    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "*.zshrc": "deny",
      "trifrost": "deny",
      "trifrost/*": "deny",
      "*/trifrost": "deny",
      "*/trifrost/*": "deny",
      "*.ssh": "deny",
      "*.ssh/*": "deny",
      "*.aws": "deny",
      "*.aws/*": "deny",
      "*.gnupg": "deny",
      "*.gnupg/*": "deny",
      "*.kube": "deny",
      "*.kube/*": "deny",
      "*.docker": "deny",
      "*.docker/*": "deny",
      "*.config/gh": "deny",
      "*.config/gh/*": "deny",
      "*.local/share/opencode/auth.json": "deny",
      "*.netrc": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny"
    },
    "external_directory": {
      "*/trifrost/*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gh/*": "deny"
    },
    "bash": {
      "kontext *": "deny",
      "*/kontext *": "deny",
      "command kontext *": "deny",
      "ansible-vault *": "deny",
      "*/ansible-vault *": "deny",
      "command ansible-vault *": "deny",
      "eval-env *": "deny",
      "*/eval-env *": "deny",
      "command eval-env *": "deny",
      "env": "deny",
      "printenv*": "deny",
      "*--show-token*": "deny",
      "gh auth token*": "deny",
      "aws configure get*": "deny",
      "security find-generic-password*": "deny",
      "security find-internet-password*": "deny",
      "security dump-keychain*": "deny",
      "*.ssh/*": "deny",
      "*.gnupg/*": "deny",
      "*.aws/credentials*": "deny",
      "*.netrc*": "deny",
      "*.git-credentials*": "deny",
      "*id_rsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
      "*share/opencode/auth.json*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  }
}
