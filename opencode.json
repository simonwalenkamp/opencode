{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["github-copilot"],
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*.zshrc": "deny",
      "*.trifrost": "deny",
      "*.trifrost/*": "deny",

      "*.ssh": "deny",
      "*.ssh/*": "deny",
      "*.aws": "deny",
      "*.aws/*": "deny",
      "*.gnupg": "deny",
      "*.gnupg/*": "deny",
      "*.kube/config": "deny",
      "*.docker/config.json": "deny",
      "*.config/gh/hosts.yml": "deny",
      "*.local/share/opencode/auth.json": "deny",
      "*.netrc": "deny",
      "*.npmrc": "deny"
    },

    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.envrc": "deny",
      "*.zshrc": "deny",
      "*.trifrost": "deny",
      "*.trifrost/*": "deny",

      "*.ssh": "deny",
      "*.ssh/*": "deny",
      "*.aws": "deny",
      "*.aws/*": "deny",
      "*.gnupg": "deny",
      "*.gnupg/*": "deny",
      "*.kube/config": "deny",
      "*.docker/config.json": "deny",
      "*.config/gh/hosts.yml": "deny",
      "*.local/share/opencode/auth.json": "deny",
      "*.netrc": "deny",
      "*.npmrc": "deny"
    },

    "glob": {
      "*": "ask",
      "*.trifrost*": "deny"
    },

    "grep": "ask",

    "list": {
      "*.trifrost": "deny",
      "*.trifrost/*": "deny"
    },

    "external_directory": {
      "*.trifrost": "deny",
      "*.trifrost/*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.local/share/opencode/*": "deny",
      "~/.local/share/opencode/tool-output/*": "allow"
    },

    "bash": {
      "*": "ask",

      "*.env*": "deny",
      "*.zshrc*": "deny",
      "*.trifrost*": "deny",
      "*.ssh*": "deny",
      "*.aws*": "deny",
      "*.gnupg*": "deny",
      "*.kube/config*": "deny",
      "*.docker/config.json*": "deny",
      "*.config/gh/hosts.yml*": "deny",
      "*.local/share/opencode/auth.json*": "deny",
      "*.netrc*": "deny",
      "*.npmrc*": "deny",

      "sudo": "deny",
      "sudo *": "deny",
      "*/sudo": "deny",
      "*/sudo *": "deny",
      "command sudo": "deny",
      "command sudo *": "deny",
      "rm": "deny",
      "rm *": "deny",
      "*/rm": "deny",
      "*/rm *": "deny",
      "command rm": "deny",
      "command rm *": "deny",
      "git reset --hard*": "deny",
      "git * reset --hard*": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git * clean": "deny",
      "git * clean *": "deny",
      "git restore": "deny",
      "git restore *": "deny",
      "git * restore": "deny",
      "git * restore *": "deny",
      "git checkout --": "deny",
      "git checkout -- *": "deny",
      "git * checkout --": "deny",
      "git * checkout -- *": "deny",
      "git stash drop": "deny",
      "git stash drop *": "deny",
      "git * stash drop": "deny",
      "git * stash drop *": "deny",
      "git reflog expire": "deny",
      "git reflog expire *": "deny",
      "git * reflog expire": "deny",
      "git * reflog expire *": "deny",
      "docker system prune*": "deny",
      "docker * system prune*": "deny",
      "gh repo delete*": "deny",
      "gh * repo delete*": "deny",
      "terraform destroy*": "deny",
      "terraform * destroy*": "deny",

      "*kontext*": "deny",
      "*ansible-vault*": "deny",
      "*eval-env*": "deny",

      "git push --force": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease": "deny",
      "git push --force-with-lease *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push * --force*": "deny",
      "git push * --force-with-lease*": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git * push --force*": "deny",
      "git * push * --force*": "deny",
      "git * push -f": "deny",
      "git * push -f *": "deny",
      "git * push * -f": "deny",
      "git * push * -f *": "deny"
    }
  }
}
